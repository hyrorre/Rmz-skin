local t = require("play")
t.header.type = 24
t.header.name = t.header.name .. " for8key"

local h, c = 			t.processHeader(t.header.type)
t.header.property = 	h.property
t.header.filepath = 	h.filepath
t.header.offset = 		h.offset
t.header.category = 	c

if skin_config then
	return t.main()
else
	return t.header
end
